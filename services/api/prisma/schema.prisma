model AnalysisRunSource {
  id                 String                @id @default(uuid())
  analysisRunId      String
  sourceType         AnalysisRunSourceType
  documentEvidenceId String?
  textEvidenceId     String?
  sourceSha256       String
  sourceLabel        String?
  sourceStatusAtRun  String?
  createdAt          DateTime              @default(now())
  analysisRun        AnalysisRun           @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  documentEvidence   DocumentEvidence?     @relation(fields: [documentEvidenceId], references: [id], onDelete: Restrict)
  textEvidence       TextEvidence?         @relation(fields: [textEvidenceId], references: [id], onDelete: Restrict)

  // F3.1: los items de inventario que SELECCIONARON esta representacion de
  // extraccion. Solo filas INCLUDED pueden apuntar aca.
  selectedByReasoningRunInventoryItems ReasoningRunInventoryItem[]
  selectedByVerificationRunInventoryItems VerificationRunInventoryItem[]

  // F1.1 -- EXTRACTION SLOT. Ver evidence-reasoning-f0.6-persistence-design.md.
  //
  // Todo lo de arriba es el SOURCE SNAPSHOT: IMMUTABLE_FROM_CREATION.
  // Estos tres campos son el slot de extraccion: MONOTONIC_FILL_ONCE.
  //
  //   ABSENT   los tres null      <- estado de toda fila previa a F1
  //   PRESENT  los tres no-null   <- se llena exactamente UNA vez
  //
  // Permitido:  ABSENT -> PRESENT
  // Prohibido:  PRESENT -> otro PRESENT distinto
  //             PRESENT -> ABSENT
  //             bundle parcialmente poblado
  //             sobrescribir porque exista un parser o una version mas nueva
  //
  // Una extraccion distinta de la misma fuente pertenece a OTRO AnalysisRun, no a
  // una mutacion del historico: eso es lo que hace que "el run conserva exactamente
  // lo que uso" sea una garantia y no una convencion. El llenado atomico condicional
  // es responsabilidad de F1.2; F1.1 solo crea el slot.
  //
  // Ninguna metadata del artifact se duplica en columnas: identity, coverage,
  // fingerprint, paginas, segmentos y diagnosticos viven DENTRO del artifact y se
  // obtienen verificandolo con F0.4 en la lectura.
  extractionArtifactCanonicalJson String?                    @db.Text
  artifactBlobSha256              String?
  extractionDerivationTrust       ExtractionDerivationTrust?

  @@unique([analysisRunId, documentEvidenceId])
  @@unique([analysisRunId, textEvidenceId])
  @@index([analysisRunId])
  @@index([documentEvidenceId])
  @@index([textEvidenceId])
  @@index([sourceSha256])
}

model FormativeProfile {
  id               String         @id @default(uuid())
  schemaVersion    String         @default("formative_profile_v1")
  userId           String
  generatedAt      DateTime
  credentialsCount Int
  totalHours       Decimal        @db.Decimal(10, 2)
  profileVersion   String?
  isCurrent        Boolean        @default(false)
  generationMethod String?
  areasSummary     Json
  skillsSummary    Json
  evidenceByArea   Json
  qualityFlags     Json
  profileJson      Json?
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sharingGrants    SharingGrant[]

  @@index([userId])
  @@index([generatedAt])
  @@index([isCurrent])
}

// PROVENANCE EXPLICITA (S8c1). Hasta ahora "mock vs real" solo se podia
// inferir del contract address centinela `0x...0001`; eso alcanzaba mientras
// la unica red real era Anvil, pero NO distingue mock / Anvil real / Base
// Sepolia real. Los cinco campos nuevos son TODOS nullable a proposito: las
// filas existentes quedan como legacy/desconocido y NO se les inventa
// procedencia. Un record historico tiene que seguir siendo interpretable
// aunque la configuracion ACTUAL cambie, asi que la identidad del deployment
// y del signer viven en la fila, no en la config viva.
model BlockchainRecord {
  id                      String                 @id @default(uuid())
  schemaVersion           String                 @default("blockchain_record_v1")
  credentialId            String
  credentialHash          String
  hashAlgorithm           String
  canonicalizationVersion String
  network                 BlockchainNetwork
  chainId                 Int
  contractAddress         String
  // NULLABLE desde S8c6: los tres campos de abajo son HECHOS DE LA CADENA y no
  // existen todavia cuando se persiste el intent `pending`. NULL significa
  // "todavia no observado", nunca "vacio": no hay placeholder `"pending"`, ni
  // `""`, ni bloque 0, ni ZeroAddress. Una fila legacy o `registered` los tiene
  // poblados; una fila `pending` real los tiene los tres en null.
  //
  // No hay `@unique` sobre `txHash` -- solo un indice -- asi que hacerlo
  // nullable no toca ninguna restriccion de unicidad.
  txHash                  String?
  // Es la cuenta que REGISTRO el hash (`transaction.from`), nunca la identidad
  // institucional del issuer. `anchorSignerProfileId` hace esa procedencia
  // explicita. El registrante ESPERADO se deriva de ese perfil; este campo
  // guarda el OBSERVADO, y por eso solo se completa con evidencia de cadena.
  issuerAddress           String?
  // Momento en que la registracion ocurrio EN LA CADENA: sale de
  // `block.timestamp`, nunca del reloj del servidor.
  registeredAt            DateTime?
  status                  BlockchainRecordStatus
  revokedAt               DateTime?
  revocationReason        String?                @db.Text
  // mock | credential_registry. Null = fila legacy anterior a S8c1.
  evidenceMode            BlockchainEvidenceMode?
  // Clave hacia el manifest commiteado en contracts/deployments/. Null =
  // legacy.
  deploymentId            String?
  // Int32 alcanza: a ~2 s por bloque haria falta mas de un siglo para desbordar
  // 2_147_483_647. Hoy el write client lo calcula y lo descarta.
  blockNumber             Int?
  // Que SignerProfile firmo la registracion. Es LA respuesta a la rotacion de
  // anchor: la revocacion debe resolver el signer historico, no el configurado
  // hoy. `onDelete: Restrict` explicito -- el default de Prisma para una
  // relacion opcional es SetNull, que borraria silenciosamente esta
  // procedencia.
  anchorSignerProfileId   String?
  // SNAPSHOT del momento de registracion. NO se deriva de cuantos issuers
  // referencian hoy al anchor profile: los bindings pueden cambiar despues de
  // la emision y eso reescribiria el significado historico.
  anchorRegistrantScope   AnchorRegistrantScope?
  credential              Credential             @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  anchorSignerProfile     SignerProfile?         @relation("BlockchainRecordAnchorSigner", fields: [anchorSignerProfileId], references: [id], onDelete: Restrict)

  @@index([credentialId])
  @@index([credentialHash])
  @@index([network])
  @@index([chainId])
  @@index([txHash])
  @@index([credentialId, network, chainId])
  @@index([evidenceMode])
  @@index([anchorSignerProfileId])
}

model VerificationEvent {
