model SharingGrant {
  id                 String              @id @default(uuid())
  userId             String
  credentialId       String?
  profileId          String?
  createdByUserId    String?
  scope              SharingGrantScope
  tokenHash          String              @unique
  // Sobre de cifrado autenticado con el token crudo adentro, para que el DUENO
  // pueda volver a copiar su enlace. NUNCA es autoridad publica: la busqueda
  // publica sigue siendo por `tokenHash`. Nullable solo por seguridad de
  // migracion; todo enlace nuevo lo trae.
  tokenRecovery      String?
  expiresAt          DateTime?
  revokedAt          DateTime?
  createdAt          DateTime            @default(now())
  lastUsedAt         DateTime?
  metadata           Json?
  user               User                @relation("SharingGrantOwner", fields: [userId], references: [id], onDelete: Cascade)
  credential         Credential?         @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  profile            FormativeProfile?   @relation(fields: [profileId], references: [id], onDelete: SetNull)
  createdByUser      User?               @relation("SharingGrantCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  verificationEvents VerificationEvent[]
  verificationPolicy ShareVerificationPolicy?
  verificationRequests VerificationRequest[]
  verificationRuns     VerificationRun[]
  verificationProposalAttempts VerificationProposalAttempt[]
  verificationExecutionLease   VerificationExecutionLease?

  @@index([userId])
  @@index([credentialId])
  @@index([profileId])
}

// CONSENTIMIENTO DE COMPUTO. Responde UNA pregunta: "el holder autoriza que un
// tercero, a traves de ESTE SharingGrant, pida un analisis contextual sobre su
// evidencia?".
//
// POR QUE UNA TABLA Y NO UN CAMPO EN `SharingGrant.metadata`. Es estado de
// seguridad: tiene que ser tipado, consultable e indexable, y `policyVersion`
// tiene que poder congelarse mas adelante dentro de un VerificationRun. Un JSON
// libre no da ninguna de las tres cosas.
//
// VER EL PERFIL Y COMPUTAR SOBRE EL SON PERMISOS DISTINTOS. Un SharingGrant
// activo autoriza LEER la proyeccion publica. Nunca autoriza razonamiento: eso
// exige ademas esta fila con `enabled = true`. El grant sigue siendo la
// autoridad de orden superior -- revocado o vencido, esta politica no habilita
// nada, y por eso revocar un enlace NO necesita tocar esta tabla.
model ShareVerificationPolicy {
  id             String   @id @default(uuid())
  sharingGrantId String   @unique
  // Deshabilitado por defecto, SIEMPRE. Ningun grant preexistente gana
  // autoridad de computo por existir esta tabla.
  enabled        Boolean  @default(false)
  // Arranca en 1 y solo avanza cuando el HOLDER cambia su politica: `enabled` o
  // el conjunto autorizado. NUNCA por ciclo de vida externo (una credencial
  // revocada despues no es un cambio de intencion del holder).
  policyVersion  Int      @default(1)
  enabledAt      DateTime?
  disabledAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Cascade: la politica no tiene sentido sin su grant.
  sharingGrant           SharingGrant                            @relation(fields: [sharingGrantId], references: [id], onDelete: Cascade)
  authorizedCredentials  ShareVerificationCredentialAuthorization[]
}

// UNA FILA POR CREDENCIAL QUE EL HOLDER ELIGIO EXPLICITAMENTE.
//
// Existe porque `scope = profile` NO enumera evidencia: el perfil publico
// resuelve sus credenciales en vivo (`issued`, `take 10`) y eso es una
// PROYECCION DE PRESENTACION, no un contrato de autorizacion. Para que un
// tercero dispare razonamiento hace falta una eleccion deliberada, credencial
// por credencial.
//
// CONSENTIMIENTO != ELEGIBILIDAD DE EJECUCION. Esta fila dice "el holder
// permite usar esta credencial". No dice que hoy tenga extraccion, analisis
// semantico ni evidence units: eso se resuelve --y se congela-- recien al crear
// un VerificationRun, intersectando este conjunto con la evidencia realmente
// ejecutable. Por eso aca no se guarda ningun estado transitorio del pipeline.
model ShareVerificationCredentialAuthorization {
  id           String   @id @default(uuid())
  policyId     String
  credentialId String
  authorizedAt DateTime @default(now())

  policy     ShareVerificationPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  // Restrict: una credencial no puede desaparecer por debajo de un
  // consentimiento otorgado. Borrar la credencial exige retirar antes la
  // autorizacion, de forma explicita.
  credential Credential              @relation(fields: [credentialId], references: [id], onDelete: Restrict)

  @@unique([policyId, credentialId])
  @@index([policyId])
  @@index([credentialId])
}

// F2 -- OBJECTIVE / REQUIREMENT.
// Ver evidence-reasoning-f2.0-objective-requirement-foundation-design.md.
//
// Tokens en MAYUSCULA a proposito: son EXACTAMENTE los mismos que el artifact
// `objective_definition_v1` guarda en `definition.objectiveType`. El contrato
// exige `Objective.objectiveType == definition.objectiveType`, y cualquier
// traduccion de casing entre columna y artifact volveria esa comparacion una
// conversion en vez de una igualdad. Mismo precedente que ExtractionDerivationTrust.
enum ObjectiveType {
  EMPLOYMENT
  SCHOLARSHIP
  ADMISSION
  EQUIVALENCE
  OTHER
}

// Minusculas, siguiendo a CredentialSemanticInterpretationStatus, que modela
// exactamente el mismo ciclo de vida activo/reemplazado.
enum ObjectiveStatus {
  active
  superseded
}

// Contexto externo contra el cual se interpretara evidencia formativa.
//
// UNA FILA FINALIZADA ES UNA VERSION INMUTABLE. No hay tabla de versiones, ni
// numero de version, ni draft: editar produce una fila NUEVA que apunta a la
// anterior con `supersedesObjectiveId`, y la anterior pasa a `superseded`.
// Asi un resultado historico de reasoning nunca cambia de significado porque
// alguien edito el Objective despues.
//
// HOLDER-INDEPENDENT. `definition` describe la oportunidad y sus requisitos:
// nunca evidencia, credenciales, conclusiones ni gaps de una persona. Eso es
// distinto de `ownerUserId`, que es solo ACCESS OWNERSHIP.
//
// `definition` es el artifact `objective_definition_v1` completo, con los
// Requirements anidados. RequirementFacet y Objective Analysis NO se persisten
// aca: son artefactos de reasoning y pertenecen al futuro ReasoningRun.
//
// Sin columna de schemaVersion: el artifact la lleva dentro y es requerida, asi
// que una columna seria un segundo testigo del mismo hecho. Sin `updatedAt` ni
// `finalizedAt`: no hay drafts, `createdAt` ES el instante de finalizacion.
model Objective {
  id                    String          @id @default(uuid())
  ownerUserId           String
  objectiveType         ObjectiveType
  title                 String
  definition            Json
  supersedesObjectiveId String?
  status                ObjectiveStatus @default(active)
  createdAt             DateTime        @default(now())

  owner         User           @relation("ObjectiveOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  // Auto-referencia: la revision apunta a la fila que reemplaza. `Restrict`
  // porque un Objective historico no debe poder desaparecer por debajo de su
  // sucesor; F2.1 no implementa delete.
  supersedes    Objective?     @relation("ObjectiveRevision", fields: [supersedesObjectiveId], references: [id], onDelete: Restrict)
  supersededBy  Objective[]    @relation("ObjectiveRevision")
  reasoningRuns ReasoningRun[]

  @@index([ownerUserId, status])
  @@index([ownerUserId, createdAt])
  @@index([supersedesObjectiveId])
}

// F3.1 -- REASONING RUN.
//
// Ver evidence-reasoning-f3.0-reasoning-run-product-contract.md.

// Lifecycle OPERACIONAL del run. Minusculas, siguiendo a AnalysisRunStatus, que
// modela el mismo ciclo. Sin `canceled`: F3.0 no congelo cancelacion.
//
// NO CONFUNDIR con el estado epistemologico de un Requirement
// (SUPPORTED | PARTIALLY_SUPPORTED | INSUFFICIENT_EVIDENCE | NOT_ASSESSABLE |
// ABSTAIN), que vive DENTRO de `resultArtifact` y es por Requirement. `ABSTAIN`
// no pertenece a este enum: un run que completa habiendo abstenido es
// `completed`, no `failed`.
enum ReasoningRunStatus {
  pending
  running
  completed
  failed
}

// Que paso con cada item del inventario congelado.
//
// MAYUSCULA: son los mismos tokens del contrato F3.0 y de los artifacts.
//
// DOS FAMILIAS, y el prefijo las separa a proposito:
//
//   EXCLUDED_*  la candidata queda fuera del grounding set   -> el run PUEDE seguir
//   BLOCKED_*   la fuente fue SELECCIONADA y su extraccion   -> el run DEBE fallar
//               requerida falta o no es confiable               antes de razonar
//
// Los dos BLOCKED_* son HECHOS DISTINTOS y por eso son tokens distintos:
//
//   BLOCKED_EXTRACTION_UNAVAILABLE        no existe slot de extraccion persistido
//                                         para la fuente seleccionada
//   BLOCKED_EXTRACTION_INTEGRITY_FAILURE  habia una representacion presente y se
//                                         la sometio a verificacion, pero fallo
//                                         el contrato de integridad/binding de F1
//
// El segundo se persiste SOLO cuando el sistema observo deterministicamente esa
// violacion. No es un catch-all para base caida, timeout ni excepcion interna:
// eso hace fallar el run por `failureCode`, sin inventar una disposicion de
// inventario que nunca llego a determinarse.
//
// `EXCLUDED_DUPLICATE_SOURCE` NO esta: F3.0 lo audito como inalcanzable en V1
// -- con la identidad `(entidad de evidencia + sourceSha256)` y un solo current
// por tipo y credencial, dos credenciales que comparten el mismo PDF son
// candidatas distintas. No se anticipan estados persistidos sin productor; si
// algun dia es alcanzable, entra por una migracion nueva.
enum ReasoningRunInventoryDisposition {
  INCLUDED
  EXCLUDED_CREDENTIAL_STATE_DRAFT
  EXCLUDED_CREDENTIAL_STATE_REVOKED
  EXCLUDED_NO_GROUNDING_SOURCE
  EXCLUDED_SOURCE_SUPERSEDED
  EXCLUDED_UNSUPPORTED_TYPE
  EXCLUDED_ALTERNATE_REPRESENTATION
  BLOCKED_EXTRACTION_UNAVAILABLE
  BLOCKED_EXTRACTION_INTEGRITY_FAILURE
}

// Evaluacion de un Objective contra la evidencia formativa de UN holder.
//
// TRES SLOTS DE ETAPA, cada uno MONOTONIC_FILL_ONCE, con la misma disciplina que
// el extraction slot de F1.1:
//
//   objectiveAnalysisArtifact  objective_analysis_v1     ABSENT -> PRESENT, una vez
//   evidenceUnitsArtifact      evidence_units_v1         ABSENT -> PRESENT, una vez
//   resultArtifact             reasoning_run_result_v1   ABSENT -> PRESENT, una vez
//
// Un run fallido conserva asi los outputs EXACTOS de las etapas que si
// terminaron, sin que nada los llame resultado final. El resultado existe si y
// solo si `resultArtifact` esta presente.
//
// UNA AUTORIDAD PERSISTIDA POR HECHO: `resultArtifact` NO recopia el Objective
// Analysis ni las EvidenceUnits; los referencia por `requirementId` /
// `evidenceUnitId`.
//
// `objectiveDefinitionSnapshot` es el artifact `objective_definition_v1` EXACTO
// que se uso. Editar el Objective despues no puede cambiar el significado de un
// run historico. Sin fingerprint ni hash: la inmutabilidad es de APLICACION
// (OBJECTIVE_SNAPSHOT_TAMPER_EVIDENT_AT_REST: NO), y una columna de hash
// prometeria una deteccion de manipulacion que no existe.
//
// SIN `updatedAt`: nada se actualiza salvo los slots fill-once y las marcas de
// lifecycle, y cada una tiene su propia columna. Sin score global del Objective,
// sin porcentaje, sin ranking: la especificacion congelada los excluye.
model ReasoningRun {
  id                          String             @id @default(uuid())
  ownerUserId                 String
  objectiveId                 String
  objectiveDefinitionSnapshot Json
  // Metadata de UI para historial. FUERA del snapshot a proposito: `title` es
  // ROW_METADATA_ONLY y no participa del razonamiento.
  objectiveTitleSnapshot      String
  status                      ReasoningRunStatus @default(pending)
  objectiveAnalysisArtifact   Json?
  evidenceUnitsArtifact       Json?
  resultArtifact              Json?
  // Contrato `reasoning_execution_metadata_v1`. Fill-once igual que los slots de
  // etapa, pero NO es un cuarto stage artifact: describe la configuracion de
  // ejecucion congelada antes de las llamadas, no un output de etapa.
  executionMetadata           Json?
  // Codigo operacional cerrado del lado de TypeScript, `String` en la base: los
  // codigos de fallo operacional crecen sin que eso deba costar una migracion.
  // Nunca un mensaje, un error crudo ni texto del proveedor.
  failureCode                 String?
  createdAt                   DateTime           @default(now())
  startedAt                   DateTime?
  completedAt                 DateTime?
  failedAt                    DateTime?

  owner     User      @relation("ReasoningRunOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  // Restrict: un Objective no puede desaparecer por debajo de un run que lo
  // evaluo. El snapshot sobrevive igual, pero perder la fila romperia la
  // trazabilidad de contra que se evaluo.
  objective Objective @relation(fields: [objectiveId], references: [id], onDelete: Restrict)

  inventory ReasoningRunInventoryItem[]

  @@index([ownerUserId, createdAt])
  @@index([ownerUserId, objectiveId])
}

// UNA FILA POR ITEM DEL INVENTARIO CONGELADO de un run.
//
// El inventario esta enraizado en la CREDENCIAL, no en la fuente, y por eso la
// tabla no se llama `ReasoningRunSource`: hay filas que no tienen ninguna.
//
//   CREDENTIAL_LEVEL   la credencial queda fuera antes de mirar sus fuentes
//                      EXCLUDED_CREDENTIAL_STATE_DRAFT / _REVOKED
//                      EXCLUDED_NO_GROUNDING_SOURCE
//                      -> credentialId; el resto NULL
//
//   SOURCE_LEVEL       una fila por representacion de fuente
//                      -> credentialId + exactamente una entidad de evidencia
//                         + sourceSha256
//
// Los CHECK que hacen cumplir esas dos formas viven en la migracion, igual que
// `AnalysisRunSource_exactly_one_source`: schema.prisma no modela CHECKs.
//
// `selectedAnalysisRunSourceId` es EL CANDIDATO DETERMINISTA QUE ESTE RUN
// SELECCIONO. No "alguna extraccion historica que existe para esta fuente", y
// tampoco "la que uso con exito": HD-3 selecciona por tiempo y verifica despues,
// asi que hay un candidato concreto incluso cuando la verificacion falla.
//
// QUE HAYA ENTRADO AL GROUNDING es un hecho DISTINTO y lo dicen otras columnas:
//
//   disposition = INCLUDED  +  runLocalSourceId presente
//
// Por eso una consulta de "que material entro al razonamiento" filtra por
// disposition o por runLocalSourceId, NUNCA por la sola presencia del binding.
//
//   INCLUDED                              las tres columnas presentes
//   BLOCKED_EXTRACTION_INTEGRITY_FAILURE  solo el id del candidato que fallo
//   resto                                 las tres en NULL
//
// Las filas EXCLUDED_* lo llevan en NULL aunque esa fuente tenga extracciones
// previas de F1 -- el caso del TextEvidence alterno de una credencial con PDF.
// Ahi no se selecciono nada, que es distinto de haber seleccionado y fallado.
//
// Sin `exclusionReason` de texto libre: la disposicion es la razon. El unico dato
// que no seria recuperable despues -- el estado de credencial observado, que
// muta -- esta dentro del propio token.
model ReasoningRunInventoryItem {
  id                          String                           @id @default(uuid())
  reasoningRunId              String
  credentialId                String
  documentEvidenceId          String?
  textEvidenceId              String?
  sourceSha256                String?
  disposition                 ReasoningRunInventoryDisposition
  selectedAnalysisRunSourceId String?
  artifactBlobSha256          String?
  // `src_01`, `src_02`, ... El `sourceId` local que ve el reasoner. Local al
  // run: no es un identificador global y no se reutiliza entre runs.
  runLocalSourceId            String?
  createdAt                   DateTime                         @default(now())

  reasoningRun              ReasoningRun       @relation(fields: [reasoningRunId], references: [id], onDelete: Cascade)
  credential                Credential         @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  documentEvidence          DocumentEvidence?  @relation(fields: [documentEvidenceId], references: [id], onDelete: Restrict)
  textEvidence              TextEvidence?      @relation(fields: [textEvidenceId], references: [id], onDelete: Restrict)
  selectedAnalysisRunSource AnalysisRunSource? @relation(fields: [selectedAnalysisRunSourceId], references: [id], onDelete: Restrict)

  // Mismo patron que `AnalysisRunSource`: un UNIQUE sobre el par con columna
  // nullable. En Postgres los NULL no colisionan entre si, asi que esto dice
  // exactamente "a lo sumo una fila por documento/texto dentro de un run" y deja
  // libres todas las filas credential-level.
  @@unique([reasoningRunId, documentEvidenceId])
  @@unique([reasoningRunId, textEvidenceId])
  @@unique([reasoningRunId, runLocalSourceId])
  @@index([reasoningRunId])
  @@index([reasoningRunId, credentialId])
  @@index([selectedAnalysisRunSourceId])
}

// =============================================================================
// VERIFICACION CONTEXTUAL PUBLICA — fundacion de persistencia y congelamiento.
//
// Producto DISTINTO del ReasoningRun del holder. Un tercero anonimo, a traves de
// un enlace compartido cuyo holder habilito el analisis contextual, define SU
// objetivo y obtiene una observacion sobre la evidencia que el holder autorizo.
//
// POR QUE NO SE REUSA ReasoningRun. Tiene `ownerUserId` y `objectiveId` NOT NULL,
// con `objective` en RESTRICT: no existe un ReasoningRun sin un Objective del
// holder. Reusarlo obligaria a crear un Objective privado que el holder nunca
// pidio, o a volver nullable una invariante de su dominio.
//
// LO QUE SI SE REUSA, A PROPOSITO:
//   - `ReasoningRunInventoryDisposition` como tipo de las filas de inventario.
//     El nombre del enum es historico; la semantica es identica y DEBE serlo:
//     una segunda enumeracion terminaria significando otra cosa en silencio.
//   - `ReasoningRunStatus` como ciclo de vida del run, por la misma razon.
//   - `objective_definition_v1` como contrato del objetivo confirmado. Ese
//     contrato ya rechaza como ESTRUCTURA cualquier clave que ligue el objetivo a
//     una persona, asi que es exactamente el adecuado para un tercero.
//   - la clasificacion de evidencia (`credential-inventory.classifier.ts`).
// =============================================================================

// Ciclo de vida PERSISTIDO de la sesion anonima del verificador.
//
// No existe un estado `expired`: nada lo produciria sin un scheduler, y un estado
// que ningun codigo escribe es una mentira del esquema. El vencimiento se DERIVA
// de `expiresAt` en cada lectura y en cada accion.
enum VerificationRequestStatus {
  draft
  requirements_proposed
  requirements_confirmed
  consumed
}

// Sesion anonima de un verificador, previa a cualquier razonamiento.
//
// Se direcciona por un token opaco cuyo valor crudo se entrega UNA sola vez al
// crearla; aca solo vive su SHA-256. El id de la fila nunca es autoridad publica.
//
// ESE TOKEN ES LA UNICA AUTORIDAD DE LA SESION: lee la solicitud, confirma
// requisitos, congela una vez y, despues, resuelve el run que produjo. Su
// `expiresAt` limita la etapa PREVIA al run; no es la vida del resultado. El
// acceso a un run ya congelado queda subordinado al enlace, no a este vencimiento.
model VerificationRequest {
  id                           String                    @id @default(uuid())
  sharingGrantId               String
  requestTokenHash             String                    @unique
  status                       VerificationRequestStatus @default(draft)
  // VERBATIM. Sin trim ni normalizacion: los offsets de la propuesta se calculan
  // sobre este texto exacto, igual que en el intake del holder.
  rawObjectiveText             String
  // Lo declara el verificador. Lo exigen el contrato de propuesta y
  // `objective_definition_v1`; el servidor lo copia a la definicion confirmada.
  objectiveType                ObjectiveType
  objectiveTitle               String?
  proposedRequirements         Json?
  // `objective_definition_v1`, el MISMO contrato que un Objective del holder. No
  // hay un segundo contrato de Requirement.
  confirmedObjectiveDefinition Json?
  createdAt                    DateTime                  @default(now())
  expiresAt                    DateTime
  confirmedAt                  DateTime?
  consumedAt                   DateTime?

  // Cascade, a diferencia del run. Una solicitud sin consumir es una sesion
  // anonima efimera y no es registro de nada. Una solicitud CONSUMIDA queda
  // protegida igual: su run la referencia en RESTRICT y el run referencia al
  // enlace en RESTRICT, asi que el borrado del enlace falla antes de tocarla.
  sharingGrant SharingGrant     @relation(fields: [sharingGrantId], references: [id], onDelete: Cascade)
  run          VerificationRun?
  proposalAttempts VerificationProposalAttempt[]

  @@index([sharingGrantId, createdAt])
}

// Observacion contextual CONGELADA sobre evidencia que el holder autorizo.
//
// No tiene `ownerUserId` ni `objectiveId`: no pertenece a una cuenta y no escribe
// en el historial privado de Objectives del holder.
//
// Tampoco tiene score, porcentaje, ranking, respuesta cruda del proveedor, prompt
// ni cadena de razonamiento. No hay columna donde ponerlos.
model VerificationRun {
  id                          String             @id @default(uuid())
  // UNIQUE: una solicitud produce A LO SUMO un run. Estructural, no solo de
  // aplicacion.
  verificationRequestId       String             @unique
  sharingGrantId              String
  // SIN token propio. La autoridad publica sobre el resultado es el MISMO token
  // de la VerificationRequest que lo produjo: una sola sesion de verificador, y
  // una respuesta perdida de la ejecucion nunca deja al tercero sin acceso.
  // El `ShareVerificationPolicy.policyVersion` que autorizo este run. Es
  // PROCEDENCIA DEL CONSENTIMIENTO, nada mas: no es un hash de evidencia, ni una
  // huella de inventario, ni una version de plan de F3. El snapshot de evidencia
  // son las filas de inventario.
  policyVersionSnapshot       Int
  objectiveDefinitionSnapshot Json
  objectiveTitleSnapshot      String?
  status                      ReasoningRunStatus @default(pending)

  // Slots de etapa, fill-once, con los MISMOS contratos que el ReasoningRun. La
  // fundacion los deja en null: no hay productor todavia.
  objectiveAnalysisArtifact Json?
  evidenceUnitsArtifact     Json?
  resultArtifact            Json?
  executionMetadata         Json?
  failureCode               String?
  // Intentos de ejecucion INICIADOS sobre este run (primero + reintentos). Tope
  // publico: 3 (2 reintentos). Se incrementa con CAS antes de reclamar el run.
  executionAttempts         Int                @default(0)

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  failedAt    DateTime?

  // Restrict: una solicitud no puede desaparecer por debajo del run que produjo.
  verificationRequest VerificationRequest @relation(fields: [verificationRequestId], references: [id], onDelete: Restrict)
  // RESTRICT, NO cascade. Un run congelado es registro de auditoria: un borrado
  // del enlace --o del usuario, que cascadea hacia sus enlaces-- no puede
  // llevarselo en silencio. Hoy no existe ningun camino ejecutable que borre un
  // enlace o un usuario, asi que esto no tiene costo operativo; convierte un
  // borrado futuro en una decision explicita de retencion. Revocar el enlace NO
  // borra nada: solo corta el acceso publico.
  sharingGrant        SharingGrant        @relation(fields: [sharingGrantId], references: [id], onDelete: Restrict)

  inventory VerificationRunInventoryItem[]

  @@index([sharingGrantId, createdAt])
}

// Espejo EXACTO de ReasoningRunInventoryItem: mismas columnas, misma disposicion,
// mismos UNIQUE parciales y mismos CHECK (en la migracion). La unica diferencia es
// a que run pertenece.
//
// El universo del que salen estas filas es el conjunto que el holder AUTORIZO, no
// su Wallet completo ni las 10 tarjetas del perfil publico. Una credencial
// autorizada que ya estaba revocada al congelar queda REGISTRADA con su
// disposicion de exclusion: distingue "el holder la autorizo" de "fue evidencia
// utilizable para este run".
model VerificationRunInventoryItem {
  id                          String                           @id @default(uuid())
  verificationRunId           String
  credentialId                String
  documentEvidenceId          String?
  textEvidenceId              String?
  sourceSha256                String?
  disposition                 ReasoningRunInventoryDisposition
  selectedAnalysisRunSourceId String?
  artifactBlobSha256          String?
  // `src_01`, `src_02`, ... INTERNO. Nunca sale por ninguna proyeccion publica.
  runLocalSourceId            String?
  createdAt                   DateTime                         @default(now())

  verificationRun           VerificationRun    @relation(fields: [verificationRunId], references: [id], onDelete: Cascade)
  credential                Credential         @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  documentEvidence          DocumentEvidence?  @relation(fields: [documentEvidenceId], references: [id], onDelete: Restrict)
  textEvidence              TextEvidence?      @relation(fields: [textEvidenceId], references: [id], onDelete: Restrict)
  selectedAnalysisRunSource AnalysisRunSource? @relation(fields: [selectedAnalysisRunSourceId], references: [id], onDelete: Restrict)

  @@unique([verificationRunId, documentEvidenceId])
  @@unique([verificationRunId, textEvidenceId])
  @@unique([verificationRunId, runLocalSourceId])
  @@index([verificationRunId])
  @@index([verificationRunId, credentialId])
  @@index([selectedAnalysisRunSourceId])
}

// Como termino un intento de propuesta que efectivamente arranco.
//
// NO hay un valor para "fallo de transporte". Ese caso NO se cierra: el cliente
// de IA colapsa en un mismo codigo el timeout de NestJS y el fallo reportado por
// el ai-service, asi que no se puede saber si la llamada al proveedor sigue en
// curso. El intento queda ABIERTO y el lease decide cuando puede reclamarse.
enum VerificationProposalAttemptOutcome {
  // La propuesta verificada se persistio en la solicitud.
  SUCCEEDED
  // Hubo respuesta y no sirve: el trabajo del proveedor TERMINO.
  FAILED
  // Supersedido por un reclamo posterior, o la autoridad (enlace, politica,
  // solicitud) se perdio antes de persistir. Su resultado nunca se acepta.
  DISCARDED
}

// UN INTENTO DE TRABAJO DE PROVEEDOR para proponer requisitos.
//
// Dos funciones, y solo dos:
//
//   CLAIM persistente   a lo sumo un intento ABIERTO por solicitud (indice
//                       unico parcial, en la migracion); sobrevive a un crash y
//                       a varias instancias de la API.
//   LIBRO DE CUOTA      cada fila es un arranque de proveedor. Cuota y cooldown
//                       por enlace se cuentan sobre `startedAt`.
//
// NO es una plataforma de analitica: no guarda IP, ni respuesta del proveedor, ni
// prompt, ni detalle de error. La propuesta autoritativa vive en
// `VerificationRequest.proposedRequirements`, nunca aca.
model VerificationProposalAttempt {
  id                    String                              @id @default(uuid())
  verificationRequestId String
  // Denormalizado a proposito: la cuota se cuenta por enlace sin join.
  sharingGrantId        String
  startedAt             DateTime                            @default(now())
  // Hasta cuando este intento es dueño exclusivo de la solicitud. Vencido, otro
  // intento puede reclamarla; el vencimiento NO invalida por si solo un
  // resultado tardio -- lo invalida quedar supersedido.
  leaseExpiresAt        DateTime
  outcome               VerificationProposalAttemptOutcome?
  finishedAt            DateTime?

  verificationRequest VerificationRequest @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade)
  sharingGrant        SharingGrant        @relation(fields: [sharingGrantId], references: [id], onDelete: Cascade)

  @@index([sharingGrantId, startedAt])
  @@index([verificationRequestId])
}

// LEASE DE EJECUCION POR ENLACE. A lo sumo UNA ejecucion publica activa por
// SharingGrant. Una fila por enlace (PK = sharingGrantId); libre cuando
// `ownerToken` es null o `expiresAt` ya paso. Se adquiere con un UPDATE
// condicional sobre ESTA fila (lock de fila, no depende de SSI) y la libera solo
// quien tiene el `ownerToken`. Un proceso muerto no bloquea para siempre: el
// lease vence.
model VerificationExecutionLease {
  sharingGrantId    String    @id
  ownerToken        String?
  verificationRunId String?
  acquiredAt        DateTime?
  expiresAt         DateTime?

  sharingGrant SharingGrant @relation(fields: [sharingGrantId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// IDENTIDAD TECNICA DEL ISSUER (S8c1)
//
// Dos roles de clave PERMANENTEMENTE separados (S8b):
//
//   ASSERTION KEY  firma el proof de la credential. Prueba autoria del issuer.
//                  Se publica en el DID Document del issuer. No necesita gas.
//                  EXACTAMENTE UNA por issuer -- estructuralmente, via el
//                  `@unique` sobre `assertionSignerProfileId`.
//
//   ANCHOR SIGNER  firma la transaccion en la red, paga gas y queda como
//                  `msg.sender` en CredentialRegistry. PUEDE compartirse entre
//                  issuers (configuracion de demo) -- por eso
//                  `anchorSignerProfileId` NO es unique.
//
// Un anchor compartido NO compromete la autenticidad por issuer, porque esa
// propiedad la lleva la assertion key, que es distinta por issuer. Pero SIGUE
// SIENDO autoridad criptografica compartida para registracion y revocacion a
// nivel de contrato: el contrato solo ve `msg.sender`. La barrera de
// autorizacion de dominio es `IssuerMembership` en la API.
// ---------------------------------------------------------------------------

// REFERENCIA a material de clave, nunca el material. No existe ninguna columna
// capaz de contener una private key: `secretRef` es el NOMBRE de un parametro
// en el secret store, no su valor.
//
// Las filas son INMUTABLES y append-only por diseño. Rotar = crear un
// SignerProfile nuevo y rebindear, NUNCA mutar ni borrar el perfil historico
// que ya firmo un proof o registro un BlockchainRecord. Todas las relaciones
// entrantes son `onDelete: Restrict` explicito por eso mismo.
model SignerProfile {
  id                  String               @id @default(uuid())
  // Nombre operativo, p. ej. "scope-demo-shared-anchor". Unico para que dos
  // perfiles no se confundan en una consola.
  label               String               @unique
  purpose             SignerProfilePurpose
  custody             SignerKeyCustody
  // NOMBRE/identificador del secreto en el secret store (SSM SecureString).
  // NUNCA el valor. Unico: dos perfiles apuntando al mismo secreto serian dos
  // "versiones" de la misma clave y romperian la semantica de rotacion.
  secretRef           String               @unique
  // Direccion estilo Ethereum derivada de ESTA clave, en minuscula sin
  // checksum (una sola representacion canonica en la base; el checksum EIP-55
  // se aplica en la capa de servicio al comparar). Unica: una fila por
  // direccion. Eso tambien impide estructuralmente que una misma clave sea a
  // la vez assertion y anchor, que es justamente el colapso que S8b elimino.
  //   assertion -> identidad compacta / objetivo de comparacion contra la
  //                direccion recuperada del proof;
  //   anchor    -> ademas, la cuenta real en la red.
  address             String               @unique
  // Material PUBLICO suficiente para construir el publicKeyJwk congelado
  // (kty EC / crv secp256k1 / x / y) SIN leer el secret store. Coordenadas
  // afines de 32 bytes en hex `0x`-prefijado minuscula; base64url se deriva en
  // la capa de servicio. Nullable porque un anchor profile no las necesita.
  publicKeyX          String?
  publicKeyY          String?
  // Clave comprimida (33 bytes, `0x02`/`0x03` + X). Util para huellas y
  // herramientas; NO es una segunda fuente de verdad de las coordenadas.
  publicKeyCompressed String?
  // Monotonica por clave logica. Para assertion keys alimenta el fragmento del
  // verificationMethod: `#assert-<keyVersion>`.
  keyVersion          Int
  // Lo setea el provisioning cuando PROBO que la direccion deriva del secreto
  // referenciado. Las lecturas de UI confian en este campo; la comprobacion
  // fuerte (derivada === almacenada) se rehace sin cache antes de cada firma.
  addressVerifiedAt   DateTime?
  status              SignerProfileStatus  @default(active)
  createdAt           DateTime             @default(now())
  retiredAt           DateTime?

  assertionForIdentity IssuerTechnicalIdentity?  @relation("IssuerTechnicalIdentityAssertionSigner")
  anchorForIdentities  IssuerTechnicalIdentity[] @relation("IssuerTechnicalIdentityAnchorSigner")
  anchoredRecords      BlockchainRecord[]        @relation("BlockchainRecordAnchorSigner")

  @@index([purpose])
  @@index([status])
}

// UNA por Issuer (`issuerId @unique`). Vincula el issuer con su DID y con sus
// dos perfiles de firma.
//
// Cardinalidades congeladas:
//   issuerId                 UNIQUE  una identidad tecnica por issuer
//   did                      UNIQUE  un DID no identifica a dos issuers
//   assertionSignerProfileId UNIQUE  una assertion key no identifica a dos
//                                    issuers (propiedad del producto)
//   anchorSignerProfileId    NO unique  anchor compartible (demo)
//
// Demo representable sin duplicar secretos:
//   UADE    -> assertion A + anchor X
//   Course  -> assertion B + anchor X
//   Company -> assertion C + anchor X
//
// `status = unconfigured` significa "bindeado pero todavia no activado"
// (p. ej. perfiles sin `addressVerifiedAt`). La AUSENCIA de la fila es el
// estado "sin identidad tecnica": un Issuer recien creado por S5b no tiene
// fila aca, y por eso `POST /admin/issuers` sigue sin pedir ninguna clave.
model IssuerTechnicalIdentity {
  id                       String                        @id @default(uuid())
  issuerId                 String                        @unique
  // `did:web:<host>:did:issuers:<issuerId>`. Write-once, igual que `User.did`:
  // nunca se recalcula contra la configuracion actual. El resolver HTTP es
  // S8c3; S8c1 solo guarda el dato.
  did                      String                        @unique
  assertionSignerProfileId String                        @unique
  anchorSignerProfileId    String
  status                   IssuerTechnicalIdentityStatus @default(unconfigured)
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt

  issuer                 Issuer        @relation(fields: [issuerId], references: [id], onDelete: Cascade)
  assertionSignerProfile SignerProfile @relation("IssuerTechnicalIdentityAssertionSigner", fields: [assertionSignerProfileId], references: [id], onDelete: Restrict)
  anchorSignerProfile    SignerProfile @relation("IssuerTechnicalIdentityAnchorSigner", fields: [anchorSignerProfileId], references: [id], onDelete: Restrict)

  @@index([anchorSignerProfileId])
  @@index([status])
}
