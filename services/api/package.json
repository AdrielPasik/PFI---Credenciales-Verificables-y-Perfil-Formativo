{
  "name": "@credential-intelligence/api",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal NestJS backend scaffold with Prisma tooling.",
  "scripts": {
    "dev": "node --watch --require ts-node/register --require reflect-metadata src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "prisma:format": "prisma format --schema prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:migrate:status": "prisma migrate status --schema prisma/schema.prisma",
    "prisma:seed": "node --env-file=.env -r ts-node/register/transpile-only prisma/seed.ts",
    "db:seed": "node -r ts-node/register/transpile-only prisma/seed.ts",
    "db:verify-demo": "node -r ts-node/register/transpile-only prisma/verify-demo-database.ts",
    "blockchain:register": "node --env-file=.env -r ts-node/register/transpile-only -r reflect-metadata src/blockchain/scripts/register-credential-on-registry.ts",
    "blockchain:revoke": "node --env-file=.env -r ts-node/register/transpile-only -r reflect-metadata src/blockchain/scripts/revoke-credential-on-registry.ts",
    "blockchain:status": "node --env-file=.env -r ts-node/register/transpile-only -r reflect-metadata src/blockchain/scripts/check-credential-registry-status.ts",
    "semantic:ingest:file": "node --env-file=.env -r ts-node/register/transpile-only -r reflect-metadata src/semantic/scripts/ingest-semantic-analysis-file.ts",
    "profile:ingest:file": "node --env-file=.env -r ts-node/register/transpile-only -r reflect-metadata src/profiles/scripts/ingest-formative-profile-file.ts",
    "ai:health": "node --env-file=.env -r ts-node/register/transpile-only -r reflect-metadata src/ai/scripts/check-ai-service-health.ts",
    "ai:analyze-pdf": "node --env-file=.env -r ts-node/register/transpile-only -r reflect-metadata src/ai/scripts/analyze-pdf-with-ai-service.ts",
    "ai:build-profile": "node --env-file=.env -r ts-node/register/transpile-only -r reflect-metadata src/ai/scripts/build-profile-with-ai-service.ts",
    "test:blockchain-evidence": "node --require ts-node/register/transpile-only --test src/blockchain/blockchain-evidence.service.test.ts",
    "test:blockchain-read-client": "node --require ts-node/register/transpile-only --test src/blockchain/credential-registry-read-client.test.ts",
    "test:blockchain-write-client": "node --require ts-node/register/transpile-only --test src/blockchain/credential-registry-write-client.test.ts",
    "test:web-cors": "node --require ts-node/register/transpile-only --test src/config/web-cors.test.ts",
    "test:auth": "node --require ts-node/register/transpile-only --test src/auth/password-hashing.test.ts src/auth/auth.service.test.ts src/auth/auth.guard.test.ts src/auth/auth.controller.test.ts",
    "test:me-wallet": "node --require ts-node/register/transpile-only --test src/me/me.controller.test.ts src/me/me.service.test.ts",
    "test:profiles": "node --require ts-node/register/transpile-only --test src/profiles/profiles.controller.test.ts src/profiles/formative-profile.service.test.ts",
    "test:profile-ingest": "node --require ts-node/register/transpile-only --test src/profiles/formative-profile-result-artifact.mapper.test.ts src/profiles/formative-profile-ai-ingest.service.test.ts src/profiles/scripts/ingest-formative-profile-file.test.ts",
    "test:ai-service-client": "node --require ts-node/register/transpile-only --test src/ai/ai-service-internal-auth.test.ts src/ai/ai-service.client.test.ts src/ai/ai-integration.service.test.ts src/ai/scripts/ai-script.utils.test.ts",
    "test:ai-endpoints": "node --require ts-node/register/transpile-only --test src/ai/ai-service-http-error.mapper.test.ts src/ai/ai-endpoints.test.ts",
    "test:analysis-run": "node --require ts-node/register/transpile-only --test prisma/analysis-run-migration.test.ts src/analysis-run/analysis-run.service.test.ts",
    "test:holder-resolution": "node --require ts-node/register/transpile-only --test src/issuers/issuers.module.wiring.test.ts src/issuers/issuer-holder-resolution.controller.test.ts src/issuers/issuer-holder-resolution.service.test.ts src/issuers/issuers.service.test.ts",
    "test:create-draft": "node --require ts-node/register/transpile-only --test src/credentials/credentials.controller.test.ts src/credentials/create-credential-draft.validator.test.ts src/credentials/credentials.service.test.ts src/issuers/issuers.service.test.ts",
    "test:academic-catalog": "node --require ts-node/register/transpile-only --test prisma/demo-academic-catalog.test.ts prisma/demo-issuer-seed.test.ts src/catalog/catalog.module.wiring.test.ts src/catalog/academic-catalog.controller.test.ts src/catalog/academic-catalog.service.test.ts src/credentials/credentials.service.test.ts src/credentials/issuer-credential-draft-update.validator.test.ts src/credentials/issuer-credential-draft-update.service.test.ts src/credentials/issuer-credential-read.mapper.test.ts src/issuers/issuers.service.test.ts",
    "test:db-verify-demo": "node --require ts-node/register/transpile-only --test prisma/verify-demo-database.test.ts",
    "test:document-evidence": "node --require ts-node/register/transpile-only --test prisma/document-evidence-migration.test.ts src/document-evidence/document-file.validator.test.ts src/document-evidence/local-document-storage.adapter.test.ts src/document-evidence/document-evidence.mapper.test.ts src/document-evidence/document-evidence.controller.test.ts src/document-evidence/document-evidence.service.test.ts src/document-evidence/document-evidence.module.wiring.test.ts src/credentials/issuer-credential-read.mapper.test.ts src/credentials/issuer-credential-read.service.test.ts src/issuers/issuers.service.test.ts",
    "test:text-evidence": "node --require ts-node/register/transpile-only --test prisma/text-evidence-migration.test.ts src/text-evidence/text-evidence.validator.test.ts src/text-evidence/text-evidence.mapper.test.ts src/text-evidence/text-evidence.controller.test.ts src/text-evidence/text-evidence.service.test.ts src/text-evidence/text-evidence.module.wiring.test.ts src/credentials/issuer-credential-read.mapper.test.ts src/credentials/issuer-credential-read.service.test.ts src/issuers/issuers.service.test.ts",
    "test:issuer-credential-read": "node --require ts-node/register/transpile-only --test src/credentials/credentials.module.wiring.test.ts src/credentials/issuer-credential-read.controller.test.ts src/credentials/issuer-credential-read.mapper.test.ts src/credentials/issuer-credential-read.service.test.ts src/issuers/issuers.service.test.ts",
    "test:issuer-credential-draft-update": "node --require ts-node/register/transpile-only --test src/credentials/credentials.module.wiring.test.ts src/credentials/issuer-credential-draft-update.controller.test.ts src/credentials/issuer-credential-draft-update.validator.test.ts src/credentials/issuer-credential-draft-update.service.test.ts src/credentials/issuer-credential-read.mapper.test.ts src/issuers/issuers.service.test.ts",
    "test:issuer-credential-type-fields": "node --require ts-node/register/transpile-only --test src/credentials/issuer-credential-draft-update.validator.test.ts src/credentials/issuer-credential-draft-update.service.test.ts src/credentials/issuer-credential-read.mapper.test.ts",
    "test:protected-issuance": "node --require ts-node/register/transpile-only --test src/credentials/credentials.controller.test.ts src/credentials/credentials.service.test.ts src/issuers/issuers.service.test.ts",
    "test:hashing": "node --require ts-node/register/transpile-only --test src/credentials/credential-hashing.service.test.ts",
    "test:semantic-artifact": "node --require ts-node/register/transpile-only --test src/semantic/semantic-analysis-artifact.mapper.test.ts",
    "test:semantic-service": "node --require ts-node/register/transpile-only --test src/semantic/semantic.service.test.ts",
    "test:semantic-cli": "node --require ts-node/register/transpile-only --test src/semantic/scripts/ingest-semantic-analysis-file.test.ts",
    "test:semantic-read": "node --require ts-node/register/transpile-only --test src/semantic/semantic.controller.test.ts",
    "test:verification-read": "node --require ts-node/register/transpile-only --test src/verification/verification.service.test.ts src/verification/verification.controller.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/platform-express": "^11.1.27",
    "@prisma/client": "6.19.3",
    "ethers": "6.15.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "prisma": "6.19.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
