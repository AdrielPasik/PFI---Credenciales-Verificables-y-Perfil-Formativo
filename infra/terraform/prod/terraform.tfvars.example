# Copy to terraform.tfvars (gitignored) and adjust. NO SECRET EVER GOES IN HERE:
# every credential lives in SSM Parameter Store or in the AWS-managed RDS secret.
#
# The defaults in variables.tf already encode the Block 1A posture, so this file
# only needs the values you want to change.

aws_region  = "us-east-1"
environment = "prod"

# --- Block 1A posture (foundations only) -----------------------------------
# No service runs, no HTTPS listener, no certificate request, no DNS record.
enable_services         = false
enable_https_listener   = false
request_acm_certificate = false
create_api_dns_record   = false

# Create the database with the foundations. Set to false to postpone the RDS
# hourly cost and apply it on the day the migrations run.
create_rds = true
# This AWS Free Plan environment requires 1 day of automated backup retention;
# the reusable default in variables.tf remains 7 days.
rds_backup_retention_days = 1

# --- Values to fill at cutover time ----------------------------------------
# Exact Vercel production origin, no trailing slash. Empty = CORS disabled.
# web_origin = "https://<project>.vercel.app"

# Hosted zone id, only if scopeedu.technology is delegated to Route 53.
# route53_zone_id = "Z0123456789ABCDEFGHIJ"

# Certificate for api.scopeedu.technology, if it was issued outside this root.
# acm_certificate_arn = "arn:aws:acm:us-east-1:<account>:certificate/<id>"

# --- Block 1B (deploy) -----------------------------------------------------
# api_image_tag = "<git-sha>"
# ai_image_tag  = "<git-sha>"
# REQUIRED, no default, no fallback to api_image_tag: plan/apply fail closed
# without it. First apply: copy the EXACT tag the live scope-prod-migrator task
# definition runs today (never rebuild it from a short SHA), so the migrator image
# does not change. Moving it to a newer image is a separate reviewed rollout.
# migrator_image_tag = "<exact-existing-migrator-tag>"
# REQUIRED, no default, no fallback to any tag. The provisioner image is referenced
# by CONTENT: the exact manifest digest, complete with the sha256: prefix. Take it
# from the reviewed API image release (a build of a commit that contains
# services/api/docker/provisioner-entrypoint.sh, S8c11.4a or later; the image the
# API runs today predates it). Never derive it from "latest" or a tag. A concrete
# value must be reviewed before any plan/apply, together with confirmation that the
# digest exists in the repository and that no lifecycle rule will expire it first.
# provisioner_image_digest = "sha256:<64-lowercase-hex>"

# Profile Embedding V1 remains disabled until the controlled rollout. Both the
# API and AI task definition receive the same gate. The default model directory
# is the frozen E5 snapshot baked into the AI image; do not use a host path.
# profile_embeddings_enabled   = false
# profile_embeddings_model_dir = "/opt/pfi/models/multilingual-e5-small"

# --- Isolated ECS sync probe -----------------------------------------------
# Its non-secret desired state is versioned in ecs_sync_probe.auto.tfvars so
# every ordinary plan from this production root retains the reviewed probe
# resources. Do not override these values in this ignored local file.

# --- GitHub Actions federation (OIDC, no access keys) ----------------------
# Verify against `git remote -v` before applying. An AWS account may hold only
# one OIDC provider for token.actions.githubusercontent.com: if one already
# exists, set create_github_oidc_provider = false and pass its ARN.
enable_github_oidc          = true
create_github_oidc_provider = true
github_owner                = "AdrielPasik"
github_repository           = "PFI---Credenciales-Verificables-y-Perfil-Formativo"
github_deploy_environments  = ["production"]
# github_oidc_provider_arn  = "arn:aws:iam::<account>:oidc-provider/token.actions.githubusercontent.com"

# --- Destroy safety ---------------------------------------------------------
# Bump this before re-destroying an environment whose previous final snapshot
# still exists; an RDS snapshot identifier can never be reused.
rds_final_snapshot_suffix = "v1"

# Blockchain evidence mechanism this infrastructure provisions for.
# "mock" (the default) wires NO CredentialRegistry RPC SecureString into the API
# task, so the task starts without that parameter existing.
# "credential_registry" wires it in and grants the execution role its exact ARN;
# the parameter itself must be created out of band first. Terraform never holds
# its value in either mode.
# blockchain_evidence_mode = "mock"
