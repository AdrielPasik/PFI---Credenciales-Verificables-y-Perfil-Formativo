  credential                 Credential                  @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  uploadedBy                 User                        @relation("DocumentEvidenceUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  analysisRunSources         AnalysisRunSource[]
