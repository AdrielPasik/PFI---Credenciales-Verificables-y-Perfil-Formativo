  active
  pending
  suspended
  archived
}

enum IssuerAuthorizationStatus {
  pending
  authorized
  revoked
}

enum IssuerMembershipRole {
  admin
  operator
  viewer
}

enum IssuerMembershipStatus {
  active
  pending
  revoked
}

enum CredentialType {
  academic_subject
  course
  certification
  degree
}

enum CredentialStatus {
  draft
  issued
  revoked
}

enum CredentialSourceType {
  academic_pdf
  course_dataset
  manual_issuer
  institutional_system
  external_import
}

enum SemanticAnalysisStatus {
  completed
  partial
}

enum BlockchainNetwork {
  anvil
  base_sepolia @map("base-sepolia")
  base_mainnet @map("base-mainnet")
}

enum BlockchainRecordStatus {
  registered
  revoked
}

enum VerificationResult {
  valid
  revoked
  invalid
  not_found
  indeterminate
}

enum RevocationStatus {
  active
  revoked
  unknown
}

enum ActorType {
  holder
  issuer_admin
  verifier
  system_admin
  public_link
  system
}

enum VerificationChannel {
  api
  qr_link
  shared_link
  internal_audit
}

enum ProgramStatus {
  draft
  active
  archived
}

enum CurriculumVersionStatus {
  draft
  active
  archived
}

enum CourseStatus {
  active
  inactive
  archived
}

enum CourseTemplateStatus {
  active
  archived
}

enum SharingGrantScope {
  credential
  profile
  credential_and_profile
}

enum DocumentEvidenceKind {
  pdf
  image
}

enum DocumentEvidenceStatus {
  current
  replaced
}

enum TextEvidenceStatus {
  current
  replaced
}

enum AnalysisRunStatus {
  pending
  running
  completed
  failed
  canceled
}

enum AnalysisRunInputMode {
  document
  text
  combined
}

enum AnalysisRunTrigger {
  manual
  system
}

enum AnalysisRunSourceType {
  document_evidence
  text_evidence
}

// F1.1: nivel de confianza de la DERIVACION del texto extraido, establecido por el
// trust gate de F0.5 al atar el artifact a su fuente autoritativa. NO es un booleano
// "trusted": la asimetria entre TEXT y PDF es real, y borrarla dejaria al consumidor
// sin saber cuanto puede apoyarse en el texto.
//
//   AUTHORITATIVE_CONTENT_MATCHED  TEXT -- el contenido autoritativo ES el texto
//                                  canonico y NestJS comprueba igualdad exacta.
//                                  La derivacion queda DEMOSTRADA.
//   PRODUCER_ASSUMED               PDF -- los bytes autoritativos se verifican por
//                                  SHA, pero NestJS no reejecuta pdfplumber/pypdf.
//                                  La derivacion queda ASUMIDA sobre el productor
//                                  interno de extraccion.
//
// Los valores van en MAYUSCULA, apartandose del snake_case de los demas enums,
// porque son tokens de contrato congelados en F0.5 y reproducidos tal cual por el
// verificador TypeScript. Un alias en minuscula obligaria a mapear entre el valor
// persistido y el token del contrato -- justo la traduccion silenciosa que F0
// elimino.
enum ExtractionDerivationTrust {
  AUTHORITATIVE_CONTENT_MATCHED
  PRODUCER_ASSUMED
}

// C4b.1a: aplicacion congelada (snapshot) de una interpretacion semantica
// aprobada (ver IssuerCourseTemplate.approvedSemantic*) sobre una credencial
// concreta ya emitida. Ver docs/architecture/
// approved-semantic-interpretation-application-v0.md (v0.2) para el diseno
// completo -- active/superseded, provenance historica source*, y por que
// "a lo sumo un active por credencial" se garantiza con un partial unique
// index manual en la migracion (Prisma no expresa WHERE en @@index/@@unique).
enum CredentialSemanticInterpretationStatus {
  active
  superseded
}

enum CredentialSemanticInterpretationSource {
  issuer_reviewed_template_snapshot
}

model User {
  id                             String                                     @id @default(uuid())
  did                            String?                                    @unique
  email                          String?                                    @unique
  firstName                      String?
  lastName                       String?
  displayName                    String?
  status                         UserStatus                                 @default(active)
  createdAt                      DateTime                                   @default(now())
  updatedAt                      DateTime                                   @updatedAt
  issuerMemberships              IssuerMembership[]
  subjectCredentials             Credential[]                               @relation("CredentialSubject")
  verifierEvents                 VerificationEvent[]                        @relation("VerifierUser")
  profiles                       FormativeProfile[]
  sharingGrants                  SharingGrant[]                             @relation("SharingGrantOwner")
  createdSharingGrants           SharingGrant[]                             @relation("SharingGrantCreator")
  authCredential                 AuthCredential?
  uploadedDocumentEvidences      DocumentEvidence[]                         @relation("DocumentEvidenceUploader")
  submittedTextEvidences         TextEvidence[]                             @relation("TextEvidenceSubmitter")
  requestedAnalysisRuns          AnalysisRun[]                              @relation("AnalysisRunRequester")
  createdCourseTemplates         IssuerCourseTemplate[]                     @relation("IssuerCourseTemplateCreator")
  appliedSemanticInterpretations CredentialReusableSemanticInterpretation[] @relation("CredentialSemanticInterpretationApplier")
  ownedObjectives                Objective[]                                @relation("ObjectiveOwner")
  reasoningRuns                  ReasoningRun[]                             @relation("ReasoningRunOwner")
}

model AuthCredential {
  id           String   @id @default(uuid())
  userId       String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Issuer {
  id                  String                    @id @default(uuid())
  name                String
  legalName           String?
  did                 String?                   @unique
  walletAddress       String?                   @unique
  authorizationStatus IssuerAuthorizationStatus @default(pending)
  authorizedAt        DateTime?
  revokedAt           DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  metadata            Json?
  credentials         Credential[]
  memberships         IssuerMembership[]
  programs            Program[]
  academicCourses     AcademicCourse[]
  courseTemplates     IssuerCourseTemplate[]

  @@index([authorizationStatus])
}

model IssuerMembership {
  id        String                 @id @default(uuid())
  userId    String
  issuerId  String
  role      IssuerMembershipRole   @default(operator)
  status    IssuerMembershipStatus @default(pending)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  issuer    Issuer                 @relation(fields: [issuerId], references: [id], onDelete: Cascade)

  @@unique([userId, issuerId])
  @@index([userId])
  @@index([issuerId])
  @@index([status])
}

model Credential {
  id                              String                                     @id @default(uuid())
  schemaVersion                   String                                     @default("credential_v1")
  type                            CredentialType
  issuerId                        String
  subjectUserId                   String
  academicCourseId                String?
  programCourseId                 String?
  externalCourseId                String?
  title                           String
  description                     String?                                    @db.Text
  sourceType                      CredentialSourceType
  status                          CredentialStatus                           @default(draft)
  hours                           Decimal?                                   @db.Decimal(10, 2)
  createdAt                       DateTime                                   @default(now())
  updatedAt                       DateTime                                   @updatedAt
  issuedAt                        DateTime?
  revokedAt                       DateTime?
  revocationReason                String?                                    @db.Text
  canonicalHash                   String?
  canonicalizationVersion         String?
  credentialSubject               Json
  metadata                        Json?
  rawData                         Json?
  issuer                          Issuer                                     @relation(fields: [issuerId], references: [id], onDelete: Restrict)
  subjectUser                     User                                       @relation("CredentialSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)
  academicCourse                  AcademicCourse?                            @relation("AcademicCourseCredentials", fields: [academicCourseId], references: [id], onDelete: SetNull)
  programCourse                   ProgramCourse?                             @relation("ProgramCourseCredentials", fields: [programCourseId], references: [id], onDelete: SetNull)
  externalCourse                  ExternalCourse?                            @relation("ExternalCourseCredentials", fields: [externalCourseId], references: [id], onDelete: SetNull)
  semanticAnalyses                SemanticAnalysis[]
  blockchainRecords               BlockchainRecord[]
  verificationEvents              VerificationEvent[]
  sharingGrants                   SharingGrant[]
  documentEvidences               DocumentEvidence[]
  textEvidences                   TextEvidence[]
  analysisRuns                    AnalysisRun[]
  reasoningRunInventoryItems      ReasoningRunInventoryItem[]
  reusableSemanticInterpretations CredentialReusableSemanticInterpretation[]

  @@index([issuerId])
  @@index([subjectUserId])
  @@index([status])
  @@index([canonicalHash])
  @@index([type])
  @@index([academicCourseId])
  @@index([programCourseId])
  @@index([externalCourseId])
}

model SemanticAnalysis {
  id               String                 @id @default(uuid())
  credentialId     String
  analysisRunId    String?
  schemaVersion    String                 @default("semantic_analysis_v1")
  status           SemanticAnalysisStatus
  pipelineVersion  String
  taxonomyVersion  String
  analyzedAt       DateTime
  confidence       Decimal?               @db.Decimal(5, 4)
  areas            Json
  skills           Json
  concepts         Json
  qualityFlags     Json
  evidenceMap      Json
  textForEmbedding String                 @db.Text
  analysisJson     Json?
  credential       Credential             @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  analysisRun      AnalysisRun?           @relation(fields: [analysisRunId], references: [id], onDelete: SetNull)

  @@index([credentialId])
  @@index([analysisRunId])
  @@index([pipelineVersion])
  @@index([credentialId, pipelineVersion, taxonomyVersion])
}

model DocumentEvidence {
  id                         String                      @id @default(uuid())
  credentialId               String
  uploadedByUserId           String
  kind                       DocumentEvidenceKind
  originalFileName           String
  mimeType                   String
  sizeBytes                  Int
  sha256                     String
  storageProvider            String
  storageKey                 String                      @unique
  status                     DocumentEvidenceStatus      @default(current)
  uploadedAt                 DateTime                    @default(now())
  replacedAt                 DateTime?
  credential                 Credential                  @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  uploadedBy                 User                        @relation("DocumentEvidenceUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  analysisRunSources         AnalysisRunSource[]
  reasoningRunInventoryItems ReasoningRunInventoryItem[]

  @@index([credentialId])
  @@index([uploadedByUserId])
  @@index([sha256])
}

model TextEvidence {
  id                         String                      @id @default(uuid())
  credentialId               String
  submittedByUserId          String
  label                      String?
  content                    String                      @db.Text
  sha256                     String
  status                     TextEvidenceStatus          @default(current)
  submittedAt                DateTime                    @default(now())
  replacedAt                 DateTime?
  credential                 Credential                  @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  submittedBy                User                        @relation("TextEvidenceSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  analysisRunSources         AnalysisRunSource[]
  reasoningRunInventoryItems ReasoningRunInventoryItem[]

  @@index([credentialId])
  @@index([submittedByUserId])
  @@index([sha256])
}

model AnalysisRun {
  id                       String               @id @default(uuid())
  credentialId             String
  requestedByUserId        String?
  status                   AnalysisRunStatus    @default(pending)
  inputMode                AnalysisRunInputMode
  trigger                  AnalysisRunTrigger
  requestedPipelineVersion String
  requestedTaxonomyVersion String
  startedAt                DateTime?
  completedAt              DateTime?
  failedAt                 DateTime?
  errorCode                String?
  errorMessage             String?              @db.Text
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  credential               Credential           @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  requestedBy              User?                @relation("AnalysisRunRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  sources                  AnalysisRunSource[]
  semanticAnalyses         SemanticAnalysis[]

  @@index([credentialId])
  @@index([requestedByUserId])
  @@index([status])
  @@index([createdAt])
}

model AnalysisRunSource {
  id                 String                @id @default(uuid())
  analysisRunId      String
  sourceType         AnalysisRunSourceType
  documentEvidenceId String?
  textEvidenceId     String?
  sourceSha256       String
  sourceLabel        String?
  sourceStatusAtRun  String?
  createdAt          DateTime              @default(now())
  analysisRun        AnalysisRun           @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  documentEvidence   DocumentEvidence?     @relation(fields: [documentEvidenceId], references: [id], onDelete: Restrict)
  textEvidence       TextEvidence?         @relation(fields: [textEvidenceId], references: [id], onDelete: Restrict)

  // F3.1: los items de inventario que SELECCIONARON esta representacion de
  // extraccion. Solo filas INCLUDED pueden apuntar aca.
  selectedByReasoningRunInventoryItems ReasoningRunInventoryItem[]

  // F1.1 -- EXTRACTION SLOT. Ver evidence-reasoning-f0.6-persistence-design.md.
  //
  // Todo lo de arriba es el SOURCE SNAPSHOT: IMMUTABLE_FROM_CREATION.
  // Estos tres campos son el slot de extraccion: MONOTONIC_FILL_ONCE.
  //
  //   ABSENT   los tres null      <- estado de toda fila previa a F1
  //   PRESENT  los tres no-null   <- se llena exactamente UNA vez
  //
  // Permitido:  ABSENT -> PRESENT
  // Prohibido:  PRESENT -> otro PRESENT distinto
  //             PRESENT -> ABSENT
  //             bundle parcialmente poblado
  //             sobrescribir porque exista un parser o una version mas nueva
  //
  // Una extraccion distinta de la misma fuente pertenece a OTRO AnalysisRun, no a
  // una mutacion del historico: eso es lo que hace que "el run conserva exactamente
  // lo que uso" sea una garantia y no una convencion. El llenado atomico condicional
  // es responsabilidad de F1.2; F1.1 solo crea el slot.
  //
  // Ninguna metadata del artifact se duplica en columnas: identity, coverage,
  // fingerprint, paginas, segmentos y diagnosticos viven DENTRO del artifact y se
  // obtienen verificandolo con F0.4 en la lectura.
  extractionArtifactCanonicalJson String?                    @db.Text
  artifactBlobSha256              String?
  extractionDerivationTrust       ExtractionDerivationTrust?

  @@unique([analysisRunId, documentEvidenceId])
  @@unique([analysisRunId, textEvidenceId])
  @@index([analysisRunId])
  @@index([documentEvidenceId])
  @@index([textEvidenceId])
  @@index([sourceSha256])
}

model FormativeProfile {
  id               String         @id @default(uuid())
  schemaVersion    String         @default("formative_profile_v1")
  userId           String
  generatedAt      DateTime
  credentialsCount Int
  totalHours       Decimal        @db.Decimal(10, 2)
  profileVersion   String?
  isCurrent        Boolean        @default(false)
  generationMethod String?
  areasSummary     Json
  skillsSummary    Json
  evidenceByArea   Json
  qualityFlags     Json
  profileJson      Json?
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sharingGrants    SharingGrant[]

  @@index([userId])
  @@index([generatedAt])
  @@index([isCurrent])
}

model BlockchainRecord {
  id                      String                 @id @default(uuid())
  schemaVersion           String                 @default("blockchain_record_v1")
  credentialId            String
  credentialHash          String
  hashAlgorithm           String
  canonicalizationVersion String
  network                 BlockchainNetwork
  chainId                 Int
  contractAddress         String
  txHash                  String
  issuerAddress           String
  registeredAt            DateTime
  status                  BlockchainRecordStatus
  revokedAt               DateTime?
  revocationReason        String?                @db.Text
  credential              Credential             @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([credentialId])
  @@index([credentialHash])
  @@index([network])
  @@index([chainId])
  @@index([txHash])
  @@index([credentialId, network, chainId])
}

model VerificationEvent {
  id                  String              @id @default(uuid())
  credentialId        String
  verifierUserId      String?
  sharingGrantId      String?
  actorType           ActorType
  verificationChannel VerificationChannel
  result              VerificationResult
  verifiedAt          DateTime            @default(now())
  hashMatch           Boolean?
  issuerValid         Boolean?
  revocationStatus    RevocationStatus?
  requestContext      Json?
  responseSummary     Json?
  credential          Credential          @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  verifierUser        User?               @relation("VerifierUser", fields: [verifierUserId], references: [id], onDelete: SetNull)
  sharingGrant        SharingGrant?       @relation(fields: [sharingGrantId], references: [id], onDelete: SetNull)

  @@index([credentialId])
  @@index([verifierUserId])
  @@index([sharingGrantId])
  @@index([verifiedAt])
