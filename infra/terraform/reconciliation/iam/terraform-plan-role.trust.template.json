{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowOnlyTheNamedOperatorUserToAssumeForPlan",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::__ACCOUNT_ID__:user/scope-operator"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringLike": {
          "sts:RoleSessionName": "tf-plan-*"
        },
        "Bool": {
          "aws:MultiFactorAuthPresent": "true"
        }
      }
    }
  ]
}
