# Configuracion publica de la app movil Holder de Scope.
#
# NADA de lo que va aca es secreto: todo lo que empieza con EXPO_PUBLIC_
# queda embebido en el bundle JavaScript y es legible por cualquiera que
# tenga el APK/IPA. NUNCA poner JWT_SECRET, claves de IA, claves de
# blockchain, credenciales de base de datos ni tokens de storage.

# Base URL del backend NestJS de Scope (el unico servicio con el que habla
# la app). Sin barra final, sin path, sin query.
#
#   Emulador Android      -> http://10.0.2.2:3001
#   Simulador iOS         -> http://127.0.0.1:3001
#   Telefono fisico (LAN) -> http://<IP-de-tu-PC>:3001   (ej. http://192.168.0.10:3001)
#   Preview / produccion  -> https://<host-publico-del-api>
#
# En produccion DEBE ser https://
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3001

# Base URL publica de Scope Web. La app la usa unicamente para construir los
# enlaces que se comparten (perfil publico y verificacion publica de una
# credencial), porque el backend devuelve rutas relativas y la verificacion
# publica es una experiencia web, no una pantalla nativa.
#
#   Desarrollo local -> http://<IP-de-tu-PC>:3000
#   Preview          -> https://<host-publico-de-scope-web>
#
# En produccion DEBE ser https://
EXPO_PUBLIC_WEB_BASE_URL=http://127.0.0.1:3000
