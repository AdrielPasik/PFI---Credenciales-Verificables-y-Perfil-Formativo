enum SemanticAnalysisStatus {
  completed
  partial
}

enum BlockchainNetwork {
  anvil
  base_sepolia @map("base-sepolia")
  base_mainnet @map("base-mainnet")
}

// `pending` se AGREGA AL FINAL a proposito: el orden de declaracion define el
// orden de comparacion del enum en PostgreSQL, y agregar al final emite un
// `ALTER TYPE ... ADD VALUE` plano (sin BEFORE/AFTER), que es la forma segura.
// Nada en el repo ordena por esta columna.
//
// S8c1 solo DECLARA el valor. Todavia es inalcanzable en la practica, porque un
// record `pending` no tiene `txHash` y esa columna sigue siendo NOT NULL hasta
// S8c6. Eso es deliberado: foundations sin cutover de comportamiento.
enum BlockchainRecordStatus {
  registered
  revoked
  pending
}

// Procedencia de la evidencia, explicita en la fila. Reemplaza la inferencia
// por contract address centinela.
enum BlockchainEvidenceMode {
  mock
  credential_registry
}

// Bajo que alcance se registro un hash on-chain. `shared_custodial` es la
// configuracion de demo: varios issuers comparten una sola cuenta de anclaje,
// asi que `CredentialRegistry` NO puede distinguirlos por `msg.sender`. No
// compromete la autenticidad por issuer -- esa la lleva la assertion key, que
// es distinta por issuer -- pero SI es autoridad criptografica compartida para
// registracion y revocacion a nivel de contrato.
enum AnchorRegistrantScope {
  issuer_exclusive
  shared_custodial
}

// Para que sirve la clave de un SignerProfile. Son roles disjuntos:
//   assertion -> firma el proof de la credential (off-chain, sin gas, una por
//                issuer, publicada en el DID Document);
//   anchor    -> firma la transaccion, paga gas, queda como `msg.sender`,
//                puede compartirse.
enum SignerProfilePurpose {
  assertion
  anchor
}

enum SignerKeyCustody {
  scope_managed
  institution_imported
}

// `retired` NUNCA significa borrado: un anchor retirado conserva su secreto y
// su financiacion porque el contrato exige el `msg.sender` original para
// revocar.
enum SignerProfileStatus {
  active
  retired
  compromised
}

enum IssuerTechnicalIdentityStatus {
  unconfigured
  active
  rotation_required
  disabled
}

