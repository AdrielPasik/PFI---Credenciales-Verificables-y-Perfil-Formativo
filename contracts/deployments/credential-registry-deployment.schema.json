{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CredentialRegistry deployment manifest v1",
  "description": "Immutable on-chain facts about ONE CredentialRegistry deployment. Written only after the deployment tool has observed and verified the chain evidence. No secrets, no RPC endpoint, no mutable operational state. The authoritative validator is services/api/src/blockchain/deployment/deployment-manifest.ts; this schema documents the same contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "deploymentId",
    "contractName",
    "network",
    "chainId",
    "contractAddress",
    "deploymentTransactionHash",
    "deploymentBlockNumber",
    "deploymentBlockHash",
    "deploymentTimestamp",
    "deployerAddress",
    "deploymentSourceCommit",
    "foundryVersion",
    "solidityVersion",
    "compilerSettings",
    "creationBytecodeHash",
    "runtimeBytecodeHash",
    "constructorArguments"
  ],
  "properties": {
    "schemaVersion": { "const": "credential_registry_deployment_v1" },
    "deploymentId": {
      "description": "base-sepolia-84532-<lowercase 0x + 40 hex of contractAddress>. Derived, never chosen.",
      "type": "string",
      "pattern": "^base-sepolia-84532-0x[0-9a-f]{40}$"
    },
    "contractName": { "const": "CredentialRegistry" },
    "network": { "const": "base_sepolia" },
    "chainId": { "const": 84532 },
    "contractAddress": {
      "description": "EIP-55 checksum address observed in the deployment receipt.",
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "deploymentTransactionHash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "deploymentBlockNumber": { "type": "integer", "minimum": 1 },
    "deploymentBlockHash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "deploymentTimestamp": {
      "description": "UTC block.timestamp of the deployment block, YYYY-MM-DDTHH:MM:SSZ. Never a local clock.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "deployerAddress": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "deploymentSourceCommit": {
      "description": "Git commit of the reviewed source/tooling the artifact was built from. NOT necessarily the commit that contains this manifest.",
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "foundryVersion": { "type": "string" },
    "solidityVersion": { "const": "0.8.26" },
    "compilerSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["optimizer", "viaIR", "evmVersion", "bytecodeHash"],
      "properties": {
        "optimizer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "runs"],
          "properties": {
            "enabled": { "const": false },
            "runs": { "const": 200 }
          }
        },
        "viaIR": { "const": false },
        "evmVersion": { "const": "cancun" },
        "bytecodeHash": { "const": "ipfs" }
      }
    },
    "creationBytecodeHash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "runtimeBytecodeHash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "constructorArguments": { "type": "array", "maxItems": 0 }
  }
}
