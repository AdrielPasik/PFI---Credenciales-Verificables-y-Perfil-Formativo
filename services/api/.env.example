PORT=3000
WEB_ORIGIN=
# Local solamente. En demo/staging, configurar DATABASE_URL fuera del repo.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/credential_intelligence"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# --- Recuperacion de contrasena ------------------------------------------------
# Por defecto la recuperacion esta APAGADA: sin estas variables, POST
# /auth/password-reset/request responde 503 y no se emite ningun token.
#
#   WEB_PUBLIC_BASE_URL  ORIGEN publico de Scope Web, desde donde se abre
#                        /reset-password. No es WEB_ORIGIN (esa es la lista de CORS)
#                        ni la URL de la API. Solo el origen: sin path, query,
#                        fragmento ni credenciales. HTTPS siempre; http solo para
#                        localhost y NUNCA con NODE_ENV=production. El host de los
#                        enlaces sale SOLO de aca, nunca del request.
#   MAIL_TRANSPORT       `disabled` (default) | `log` | `resend`.
#                          disabled  no envia nada; la recuperacion responde 503.
#                          log       SOLO desarrollo: NO envia, imprime el enlace en la
#                                    consola. Con NODE_ENV=production se ignora y la
#                                    recuperacion queda deshabilitada.
#                          resend    envio real por la API HTTPS de Resend. Exige
#                                    MAIL_FROM y RESEND_API_KEY; si falta alguna o es
#                                    invalida, cae a `disabled` (503) y el login, el
#                                    registro y /auth/me siguen funcionando.
#                        Un valor desconocido tambien cae a `disabled`.
#   MAIL_FROM            Remitente de Resend: `Nombre <usuario@dominio>`. Configuracion
#                        publica del servidor, NO es un secreto. Su dominio tiene que
#                        estar VERIFICADO en Resend antes del primer envio real.
#                        Propuesto: Scope <no-responder@mail.scopeedu.technology>
#   RESEND_API_KEY       *** SECRETO ***. Se lee solo del entorno del servidor. Jamas en
#                        el repo, en un NEXT_PUBLIC_*, en un log ni en un mensaje de
#                        error. En AWS va en SSM Parameter Store como SecureString,
#                        creada fuera de banda. Pedir una key con permiso de SOLO envio
#                        ("Sending access"), restringida al dominio.
#   TRUST_PROXY_HOPS     Cantidad EXACTA de proxies de confianza delante del API.
#                        0 (default) = no se confia en ningun X-Forwarded-For. Detras
#                        del ALB de AWS es 1. Un valor mal puesto hace que todos los
#                        clientes compartan IP, o que la IP sea falsificable.
#
# El limite por IP vive en la memoria de CADA proceso: con varias tasks no es un
# limite distribuido. Local: WEB_PUBLIC_BASE_URL=http://127.0.0.1:3000 y
# MAIL_TRANSPORT=log.
WEB_PUBLIC_BASE_URL=
MAIL_TRANSPORT=
MAIL_FROM=
RESEND_API_KEY=
TRUST_PROXY_HOPS=
AI_SERVICE_BASE_URL=http://127.0.0.1:8000
AI_SERVICE_TIMEOUT_MS=60000
# Fuente vectorial interna para Profile Embedding V1. Independiente de toda
# otra capacidad AI y desactivada por defecto. Solo habilitar junto con el
# endpoint privado equivalente del ai-service en un rollout controlado.
PROFILE_EMBEDDINGS_ENABLED=false
AI_SERVICE_AUTH_MODE=none
AI_SERVICE_JWT_SECRET=
AI_SERVICE_JWT_ISSUER=traza-api
AI_SERVICE_JWT_AUDIENCE=traza-ai-service
AI_SERVICE_JWT_EXPIRES_IN_SECONDS=60
# Clave de 32 bytes (base64 o hex) para el material de recuperacion de enlaces
# compartidos. Sin ella los enlaces se crean igual, pero su dueno no va a poder
# volver a copiarlos. NUNCA se versiona un valor real aca.
PROFILE_SHARE_TOKEN_KEY=

DOCUMENT_STORAGE_PROVIDER=local
DOCUMENT_STORAGE_LOCAL_ROOT=
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_PREFIX=document-evidence
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=
# Blockchain evidence target (S8c5). `mock` needs nothing else. In
# `credential_registry` mode ALL of the following are required and nothing falls
# back to mock when one is missing or malformed. Values here are placeholders:
# the real network, chain id, address and deployment id come from the committed
# deployment manifest in contracts/deployments/ (S8c10); never invent them.
#
#   NETWORK       base_sepolia (final target, chain 84532) | anvil (local, 31337)
#   DEPLOYMENT_ID "base-sepolia-84532-<lowercase contract address>"; the reserved
#                 value `unset` is rejected
#   RPC_URL       OPERATIONAL SECRET (the provider token lives in the URL). In AWS it
#                 is an out-of-band SSM SecureString injected by ECS; locally leave it
#                 empty or use a local Anvil URL. Never commit it, never log it. Remote
#                 endpoints must be https.
BLOCKCHAIN_EVIDENCE_MODE=mock
CREDENTIAL_REGISTRY_NETWORK=
CREDENTIAL_REGISTRY_CHAIN_ID=
CREDENTIAL_REGISTRY_CONTRACT_ADDRESS=
CREDENTIAL_REGISTRY_DEPLOYMENT_ID=
CREDENTIAL_REGISTRY_RPC_URL=

# LEGACY, local/dev only: global key used by the old blockchain:register|revoke|status
# CLI scripts against a local Anvil. It is NOT the runtime signer (issuer anchor
# SignerProfiles are) and it is NOT the deployment key: contract deployment uses an
# encrypted keystore and a hidden passphrase prompt (see contracts/DEPLOYMENT_BASE_SEPOLIA.md).
# Leave empty. Never put a real key here.
CREDENTIAL_REGISTRY_PRIVATE_KEY=

# Evidence Reasoning (F3). Modelo con el que NestJS congela el plan de
# ejecucion de un ReasoningRun. Debe coincidir EXACTAMENTE con los tres
# *_OPENAI_MODEL del ai-service: si difieren, el run falla cerrado con
# reasoning_execution_plan_mismatch antes de llamar al proveedor.
REASONING_EXECUTION_MODEL=
