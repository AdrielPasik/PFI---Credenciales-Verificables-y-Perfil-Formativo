PORT=8000
AI_SERVICE_MAX_PDF_BYTES=26214400
AI_INTERNAL_AUTH_MODE=disabled
AI_INTERNAL_JWT_SECRET=
AI_INTERNAL_JWT_ISSUER=traza-api
AI_INTERNAL_JWT_AUDIENCE=traza-ai-service
AI_INTERNAL_JWT_CLOCK_SKEW_SECONDS=30

# Evidence Reasoning (F3). UNA credencial y UN modelo por etapa: las tres
# etapas se configuran por separado para que un despliegue futuro pueda
# diferenciarlas sin cambiar codigo. En V1 el modelo es el MISMO en las tres,
# y debe coincidir con REASONING_EXECUTION_MODEL del api.
#
# La variable de MODELO nunca lleva una credencial: el arranque de cada etapa
# comprueba su forma y aborta si parece una API key.
OBJECTIVE_ANALYSIS_OPENAI_API_KEY=
OBJECTIVE_ANALYSIS_OPENAI_MODEL=
EVIDENCE_UNITS_OPENAI_API_KEY=
EVIDENCE_UNITS_OPENAI_MODEL=
CONTEXTUAL_REASONING_OPENAI_API_KEY=
CONTEXTUAL_REASONING_OPENAI_MODEL=

# --- P2.2 Objective Understanding (propuesta transitoria de Requirements) ---
# Etapa propia, con credencial y modelo dedicados: no comparte configuracion con
# las etapas del ReasoningRun. Los VALORES viven solo en el entorno de este
# servicio y nunca viajan a NestJS, ni a la respuesta, ni a un log.
OBJECTIVE_UNDERSTANDING_OPENAI_API_KEY=
OBJECTIVE_UNDERSTANDING_OPENAI_MODEL=
# Opcionales. Se omiten salvo que el despliegue los necesite.
# OBJECTIVE_UNDERSTANDING_OPENAI_BASE_URL=
# OBJECTIVE_UNDERSTANDING_PROVIDER_TIMEOUT_SECONDS=
