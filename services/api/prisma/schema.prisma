// F1.1: nivel de confianza de la DERIVACION del texto extraido, establecido por el
// trust gate de F0.5 al atar el artifact a su fuente autoritativa. NO es un booleano
// "trusted": la asimetria entre TEXT y PDF es real, y borrarla dejaria al consumidor
// sin saber cuanto puede apoyarse en el texto.
//
//   AUTHORITATIVE_CONTENT_MATCHED  TEXT -- el contenido autoritativo ES el texto
//                                  canonico y NestJS comprueba igualdad exacta.
//                                  La derivacion queda DEMOSTRADA.
//   PRODUCER_ASSUMED               PDF -- los bytes autoritativos se verifican por
//                                  SHA, pero NestJS no reejecuta pdfplumber/pypdf.
//                                  La derivacion queda ASUMIDA sobre el productor
//                                  interno de extraccion.
//
// Los valores van en MAYUSCULA, apartandose del snake_case de los demas enums,
// porque son tokens de contrato congelados en F0.5 y reproducidos tal cual por el
// verificador TypeScript. Un alias en minuscula obligaria a mapear entre el valor
// persistido y el token del contrato -- justo la traduccion silenciosa que F0
// elimino.
enum ExtractionDerivationTrust {
  AUTHORITATIVE_CONTENT_MATCHED
  PRODUCER_ASSUMED
}

// C4b.1a: aplicacion congelada (snapshot) de una interpretacion semantica
// aprobada (ver IssuerCourseTemplate.approvedSemantic*) sobre una credencial
// concreta ya emitida. Ver docs/architecture/
// approved-semantic-interpretation-application-v0.md (v0.2) para el diseno
// completo -- active/superseded, provenance historica source*, y por que
// "a lo sumo un active por credencial" se garantiza con un partial unique
// index manual en la migracion (Prisma no expresa WHERE en @@index/@@unique).
enum CredentialSemanticInterpretationStatus {
  active
  superseded
}

enum CredentialSemanticInterpretationSource {
  issuer_reviewed_template_snapshot
}

model User {
  id                             String                                     @id @default(uuid())
  did                            String?                                    @unique
  email                          String?                                    @unique
  firstName                      String?
  lastName                       String?
  displayName                    String?
  status                         UserStatus                                 @default(active)
  onboardingIntent               UserOnboardingIntent?
  createdAt                      DateTime                                   @default(now())
  updatedAt                      DateTime                                   @updatedAt
  issuerMemberships              IssuerMembership[]
  subjectCredentials             Credential[]                               @relation("CredentialSubject")
  verifierEvents                 VerificationEvent[]                        @relation("VerifierUser")
  profiles                       FormativeProfile[]
  sharingGrants                  SharingGrant[]                             @relation("SharingGrantOwner")
  createdSharingGrants           SharingGrant[]                             @relation("SharingGrantCreator")
  authCredential                 AuthCredential?
  platformAdmin                  PlatformAdmin?
  uploadedDocumentEvidences      DocumentEvidence[]                         @relation("DocumentEvidenceUploader")
  submittedTextEvidences         TextEvidence[]                             @relation("TextEvidenceSubmitter")
  requestedAnalysisRuns          AnalysisRun[]                              @relation("AnalysisRunRequester")
  createdCourseTemplates         IssuerCourseTemplate[]                     @relation("IssuerCourseTemplateCreator")
  appliedSemanticInterpretations CredentialReusableSemanticInterpretation[] @relation("CredentialSemanticInterpretationApplier")
  ownedObjectives                Objective[]                                @relation("ObjectiveOwner")
  reasoningRuns                  ReasoningRun[]                             @relation("ReasoningRunOwner")
}

model AuthCredential {
  id           String   @id @default(uuid())
  userId       String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// S1: capacidad de ADMINISTRACION DE PLATAFORMA, deliberadamente separada de
/// IssuerMembership. Una fila = un User con esa capacidad.
///
/// POR QUE UNA TABLA Y NO UN CAMPO EN User. Hoy `User` es identidad pura: no
/// tiene ni un solo campo de autorizacion. Toda autoridad de este sistema vive
/// en una ARISTA (`IssuerMembership`), nunca en el nodo `User`. Este modelo es
/// esa misma forma aplicada al plano de plataforma, y es el gemelo estructural
/// de `AuthCredential` (1:1 con User, `userId @unique`, FK onDelete: Cascade).
///
/// NO TIENE issuerId A PROPOSITO. Por construccion no puede autorizar ninguna
/// operacion sobre un Issuer concreto: un PlatformAdmin que quiera OPERAR un
/// issuer necesita su propia IssuerMembership, igual que cualquier otro User.
/// La autorizacion institucional sigue siendo exclusivamente la de
/// `IssuersService` -- este modelo no le agrega ningun bypass.
///
/// SIN @@index([userId]). `@unique` ya emite un indice unico sobre esa columna
/// (`PlatformAdmin_userId_key`), que es el que sirve al unico lookup del guard
/// (`findUnique({ where: { userId } })`). Un `@@index` seria un segundo indice
/// redundante sobre la misma columna: ni `AuthCredential.userId`, ni
/// `ShareVerificationPolicy.sharingGrantId`, ni
/// `VerificationRun.verificationRequestId` llevan companion.
///
/// SIN grantedByUserId. La trazabilidad de las mutaciones administrativas vive
/// en `AuditLog` (que ya modela el actor como `actorId String?` sin FK), no en
/// un campo con nombre de FK sin integridad referencial real dentro de una
/// tabla de dominio. La concesion inicial es out-of-band (S2) y no tiene un
/// otorgante dentro del sistema que se pueda referenciar honestamente.
///
/// SIN revokedAt: revocar es borrar la fila. El grant se resuelve contra la
/// base en CADA request (ver platform-admin.guard.ts), nunca desde el JWT, asi
/// que un DELETE revoca el acceso de inmediato sin esperar que expire el token.
model PlatformAdmin {
  id        String   @id @default(uuid())
  userId    String   @unique
  grantedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// IDENTIDAD TECNICA: ver `IssuerTechnicalIdentity`. `did` y `walletAddress`
// quedan LEGACY en S8c1 -- siguen siendo los unicos campos que lee el producto
// hoy (`assertIssuerCanIssue`, seeds, `/admin`), pero DESPUES del cutover la
// fuente de verdad pasa a ser:
//   DID              -> IssuerTechnicalIdentity.did
//   assertion key    -> IssuerTechnicalIdentity.assertionSignerProfile.address
//   anchor account   -> IssuerTechnicalIdentity.anchorSignerProfile.address
// S8c1 NO agrega un segundo writer productivo: nadie escribe
// `IssuerTechnicalIdentity` todavia. El cutover de readers es S8c9.
model Issuer {
  id                     String                    @id @default(uuid())
  name                   String
  legalName              String?
  did                    String?                   @unique
  walletAddress          String?                   @unique
  authorizationStatus    IssuerAuthorizationStatus @default(pending)
  authorizedAt           DateTime?
  revokedAt              DateTime?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  metadata               Json?
  // Que tipos de credential puede emitir este issuer. Reemplaza al
  // discriminante hardcodeado `did:example:issuer-demo` de
  // `credentials.service.ts` / `issuer-credential-draft-update.service.ts`.
  // S8c1 solo crea la columna: los dos call sites siguen usando el literal
  // hasta S8c9, para no convertir esta slice en un behavior slice.
  //
  // `@default([])` es SEMANTICA DE DOMINIO, no una comodidad del ORM. Este
  // campo va a ser authority input, asi que la base, Prisma y el dominio
  // tienen que decir lo mismo:
  //   []    -> el issuer no tiene habilitado NINGUN credential type;
  //   NULL  -> NO es un estado de dominio valido.
  // La columna se crea NOT NULL con DEFAULT de array vacio, asi que ni las
  // filas existentes ni las futuras pueden quedar en NULL, y ninguna regla de
  // autorizacion futura depende de que el ORM coaccione NULL a [] en una
  // lectura.
  allowedCredentialTypes CredentialType[] @default([])
  credentials            Credential[]
  memberships            IssuerMembership[]
  programs               Program[]
  academicCourses        AcademicCourse[]
  courseTemplates        IssuerCourseTemplate[]
  technicalIdentity      IssuerTechnicalIdentity?

  @@index([authorizationStatus])
}

model IssuerMembership {
  id        String                 @id @default(uuid())
  userId    String
  issuerId  String
  role      IssuerMembershipRole   @default(operator)
  status    IssuerMembershipStatus @default(pending)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  issuer    Issuer                 @relation(fields: [issuerId], references: [id], onDelete: Cascade)

  @@unique([userId, issuerId])
  @@index([userId])
  @@index([issuerId])
  @@index([status])
}

model Credential {
  id                              String                                     @id @default(uuid())
  schemaVersion                   String                                     @default("credential_v1")
  type                            CredentialType
  issuerId                        String
  subjectUserId                   String
  academicCourseId                String?
  programCourseId                 String?
  externalCourseId                String?
  title                           String
  description                     String?                                    @db.Text
  sourceType                      CredentialSourceType
  status                          CredentialStatus                           @default(draft)
  hours                           Decimal?                                   @db.Decimal(10, 2)
  createdAt                       DateTime                                   @default(now())
  updatedAt                       DateTime                                   @updatedAt
  issuedAt                        DateTime?
  revokedAt                       DateTime?
  revocationReason                String?                                    @db.Text
  canonicalHash                   String?
  canonicalizationVersion         String?
  credentialSubject               Json
  metadata                        Json?
  rawData                         Json?
  // PROOF `scope-proof-v1` (S8b.1). Artifact versionado, una sola columna Json
  // -- misma convencion que `metadata`/`rawData`/el snapshot semantico, y no
  // se consulta relacionalmente. Forma congelada (EXACTAMENTE 8 claves, SIN
  // `created`): type, profile, cryptosuite, proofPurpose, verificationMethod,
  // canonicalizationVersion, hashAlgorithm, proofValue.
  //
  // NULLABLE en PostgreSQL por rollout aditivo y por las filas legacy
  // `credential_v1`. Eso NO significa que un artifact serializado que declare
  // `schema_version = credential_v2` sea valido sin proof: el JSON Schema
  // `credential_v2` lo exige (ver packages/schemas/credential_v2.schema.json).
  // Son dos ejes de version distintos: `schemaVersion` (forma del credential)
  // y `canonicalizationVersion` (reglas de canonicalizacion).
  //
  // S8c1 NO escribe esta columna. La emision firmada es S8c4.
  // NUNCA contiene key material: solo la firma y metadatos publicos.
  proof                           Json?
  issuer                          Issuer                                     @relation(fields: [issuerId], references: [id], onDelete: Restrict)
  subjectUser                     User                                       @relation("CredentialSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)
  academicCourse                  AcademicCourse?                            @relation("AcademicCourseCredentials", fields: [academicCourseId], references: [id], onDelete: SetNull)
  programCourse                   ProgramCourse?                             @relation("ProgramCourseCredentials", fields: [programCourseId], references: [id], onDelete: SetNull)
  externalCourse                  ExternalCourse?                            @relation("ExternalCourseCredentials", fields: [externalCourseId], references: [id], onDelete: SetNull)
  semanticAnalyses                SemanticAnalysis[]
  blockchainRecords               BlockchainRecord[]
  verificationEvents              VerificationEvent[]
  sharingGrants                   SharingGrant[]
  documentEvidences               DocumentEvidence[]
  textEvidences                   TextEvidence[]
  analysisRuns                    AnalysisRun[]
  reasoningRunInventoryItems      ReasoningRunInventoryItem[]
  verificationRunInventoryItems   VerificationRunInventoryItem[]
  reusableSemanticInterpretations CredentialReusableSemanticInterpretation[]
  shareVerificationAuthorizations ShareVerificationCredentialAuthorization[]

  @@index([issuerId])
  @@index([subjectUserId])
  @@index([status])
  @@index([canonicalHash])
  @@index([type])
  @@index([academicCourseId])
  @@index([programCourseId])
  @@index([externalCourseId])
}

model SemanticAnalysis {
  id               String                 @id @default(uuid())
  credentialId     String
  analysisRunId    String?
  schemaVersion    String                 @default("semantic_analysis_v1")
  status           SemanticAnalysisStatus
  pipelineVersion  String
  taxonomyVersion  String
  analyzedAt       DateTime
  confidence       Decimal?               @db.Decimal(5, 4)
  areas            Json
  skills           Json
  concepts         Json
  qualityFlags     Json
  evidenceMap      Json
  textForEmbedding String                 @db.Text
  analysisJson     Json?
  credential       Credential             @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  analysisRun      AnalysisRun?           @relation(fields: [analysisRunId], references: [id], onDelete: SetNull)

  @@index([credentialId])
  @@index([analysisRunId])
  @@index([pipelineVersion])
  @@index([credentialId, pipelineVersion, taxonomyVersion])
}

model DocumentEvidence {
  id                         String                      @id @default(uuid())
  credentialId               String
