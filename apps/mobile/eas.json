{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "SET_ME",
        "EXPO_PUBLIC_WEB_BASE_URL": "SET_ME"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.scopeedu.technology",
        "EXPO_PUBLIC_WEB_BASE_URL": "https://scopeedu.technology"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "SET_ME",
        "EXPO_PUBLIC_WEB_BASE_URL": "SET_ME"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
