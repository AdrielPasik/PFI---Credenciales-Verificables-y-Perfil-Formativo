# Terraform working directories and state. Nothing here may reach Git: state can
# contain resource attributes, and *.tfvars can contain environment values.
.terraform/
.terraform.tfstate.lock.info
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Local variable and backend files. Only the *.example templates are versioned,
# except the non-secret, production probe desired-state file explicitly
# re-included below.
*.tfvars
*.tfvars.json
backend.hcl
bootstrap/backend.tf
!*.example
!prod/ecs_sync_probe.auto.tfvars

# Terraform plan artifacts (may embed resource values).
*.tfplan
*.tfplan.*

# The provider lock file IS versioned on purpose (reproducible provider set):
# do not add .terraform.lock.hcl here.
